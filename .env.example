# ============================================================
# DripClient Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.
# ============================================================

# ---- Database (PostgreSQL) ----
DATABASE_URL="postgresql://user:password@localhost:5432/dripclient"
DIRECT_URL="postgresql://user:password@localhost:5432/dripclient"

# ---- NextAuth ----
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_TRUST_HOST="true"

# ---- Google OAuth (admin login) ----
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---- Admin bootstrap (prisma seed) ----
ADMIN_INITIAL_PASSWORD="change-me-strong-password"

# ---- WijayaPay (Payment Gateway) ----
WIJAYAPAY_MERCHANT_CODE=""
WIJAYAPAY_API_KEY=""
WIJAYAPAY_IS_PRODUCTION="false"

# ---- Supabase (Storage) ----
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ---- Email (SMTP) ----
EMAIL_HOST="smtp.example.com"
EMAIL_PORT="587"
EMAIL_SECURE="false"
EMAIL_USER=""
EMAIL_PASS=""

# ---- App ----
NEXT_PUBLIC_APP_NAME="DripClient"
